# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase (public project configuration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side secret; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server-side only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Research providers (server-side only)
TAVILY_API_KEY=

# Optional provider; leave blank until its adapter and access are verified
NARA_ROUTER_API_KEY=

# Optional: generate locally when encrypted credential storage is implemented
INTEGRATION_ENCRYPTION_KEY=
